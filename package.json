{
  "name": "complex-mmc",
  "version": "0.1.0",
  "private": true,
  "description": "Complex MMC — korporativ sayt (Next.js + Payload CMS)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "content": "cross-env NODE_OPTIONS=--no-deprecation payload run src/content/apply.ts",
    "seed:pages": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/pages-only.ts",
    "db:push": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DB_PUSH=true payload run src/seed/push.ts",
    "seed:calculator": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/calculator.ts",
    "seed:mosaics": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/mosaics.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "^1.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
